{"chunk_id": "sign:sbs-shinan-plate:text-1", "unit_id": "sign:sbs-shinan-plate", "part": 1, "parts": 1, "source_id": "SRC-SBS-NAMEPLATE", "content_type": "sign", "text": "市级古树名木｜树种：石楠｜学名：Photinia serrulata｜编号：吴中203｜科属：蔷薇科石楠属｜树龄：800余年｜保护等级：一级｜责任单位：永慧禅寺｜苏州市林业局吴中分局 二〇二三年", "context_header": "现场官方古树铭牌｜吴中区 光福石壁永慧禅寺｜石楠｜吴中203", "lang": "zh-Hans", "locator": {"section": "现场标识", "title": "石楠古树铭牌（吴中203）", "heading_path": ["现场标识", "光福石壁永慧禅寺", "官方铭牌"], "media_id": "sbs-shinan_07_02.jpg"}, "tree_ids": ["sbs-shinan"], "site_ids": ["S03"], "site_name": "光福石壁永慧禅寺", "district": "吴中区", "species": ["石楠"], "official_codes": ["吴中203"], "link": {"status": "explicit", "evidence": "铭牌上的编号吴中203"}, "source_tier": "A", "as_of": "2023", "review_status": "pending", "conflict_ids": ["cf-shinan-age"], "rights": {"holder": "苏州市林业局吴中分局", "display": "full"}, "sign": {"sign_type": "official_plate", "issuer": "苏州市林业局吴中分局", "year": "2023", "media_id": "sbs-shinan_07_02.jpg"}, "pipeline": "manual-transcription@2026-10", "n_chars": 97, "content_hash": "sha256:fcc00bd46cbb1403"}
{"chunk_id": "shbl:essay-p308:body-2", "unit_id": "shbl:essay-p308", "part": 2, "parts": 5, "source_id": "SRC-SHBL", "content_type": "essay", "text": "……指出石壁精舍初创于嘉靖年间，一说为嘉靖二年（1523年），但后者并未有确切文献可考。历经世事变迁，石壁精舍逐渐衰落。直到隆庆三年（1569年），百废待兴的寺院才获得存续的转机。据《光福志》载：“明隆庆三年僧憨山复创。”……", "context_header": "《树碑立传》专栏文章｜曲径通幽花照影，禅房古木绿沉香（栾峦）｜吴中区 光福石壁永慧禅寺", "lang": "zh-Hans", "locator": {"section": "专栏文章", "title": "曲径通幽花照影，禅房古木绿沉香", "heading_path": ["专栏文章", "曲径通幽花照影，禅房古木绿沉香"], "pdf_pages": [155], "printed_pages": [309]}, "tree_ids": [], "site_ids": ["S03"], "site_name": "光福石壁永慧禅寺", "district": "吴中区", "species": [], "source_tier": "B", "as_of": "2024-08", "review_status": "pending", "review_note": "示例：text 为节选，块序号为示意", "certainty_flags": ["recorded", "hedged"], "conflict_ids": ["cf-hanshan-arrival"], "sensitivity": ["religion"], "rights": {"holder": "吴文化博物馆", "display": "full", "note": "馆方尚未确认可否在 AI 应用中引用原文"}, "essay": {"article_title": "曲径通幽花照影，禅房古木绿沉香", "author": "栾峦"}, "n_chars": 113, "content_hash": "sha256:9c8f19e024db120d"}
{"chunk_id": "faq:0001:qa-1", "unit_id": "faq:0001", "part": 1, "parts": 1, "source_id": "SRC-FAQ", "content_type": "faq", "text": "问：司徒庙的“清奇古怪”真是东汉邓禹种的、乾隆赐的名吗？\n答：目前没有确切依据。《树碑立传》梳理文献后指出，“邓禹手植”“乾隆赐名”等说法并无明确依据。可以确定的是，清代沈复在《浮生六记》中已经记下了这四棵古柏“清、奇、古、怪”的名字和样貌。", "context_header": "常见问题｜吴中区 光福司徒庙｜圆柏", "lang": "zh-Hans", "locator": {"section": "FAQ", "title": "清奇古怪的来历", "heading_path": ["FAQ", "司徒庙古柏"], "record": "faq:0001"}, "tree_ids": ["stm-yuanbai"], "site_ids": ["S02"], "site_name": "光福司徒庙", "district": "吴中区", "species": ["圆柏"], "source_tier": "B", "as_of": "2024-08", "review_status": "pending", "review_note": "示例：上线前须由馆方审核改为 verified", "certainty_flags": ["recorded", "hedged"], "sensitivity": ["religion"], "faq": {"question": "司徒庙的“清奇古怪”真是东汉邓禹种的、乾隆赐的名吗？", "alt_questions": ["清奇古怪是谁起的名字", "司徒庙古柏是邓禹手植的吗"], "evidence_chunk_ids": ["shbl:story-018:body-1"], "owner_role": "馆方讲解部门（待定）"}, "n_chars": 121, "content_hash": "sha256:a0603a4fee58412b"}
